{
    "server": {
      "http": {
        "enabled": false,
        "port": 3000
      },
      "https": {
        "enabled": true,
        "port": 443,
        "redirectAllHttpToHttps": true
      }
    },
    "db": {
      "uri": "mongodb://localhost:27017/mydatabase-prod"
    },
    "security": {
      "jwt": {
        "secret": "prod-jwt-secret",
        "expiresIn": "1h"
      },
      "cors": {
        "origins": ["https://myproductiondomain.com"]
      },
      "rateLimit": {
        "windowMs": 90000,
        "max": 1000
      }
    }
  }
  